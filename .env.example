# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Environment & Security
APP_ENV="production"
APP_DEBUG="false"
APP_SECRET="replace-with-a-64-char-random-secret-key-for-csrf-and-sessions"
TIMEZONE="Asia/Baghdad"

# Database Configuration (App DML user)
DB_DRIVER="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="tv_workshop"
DB_USERNAME="tv_app_user"
DB_PASSWORD="change_app_password"

# Database Migration Configuration (Separate DDL user)
DB_MIGRATION_USER="tv_migrator"
DB_MIGRATION_PASSWORD="change_migration_password"

# Session Durations
SESSION_IDLE_DAYS="7"
SESSION_ABSOLUTE_DAYS="30"

# GPG Backup Settings
BACKUP_DIR="/storage/backups"
BACKUP_GPG_RECIPIENT="workshop-backup@local"
BACKUP_REMOTE_DEST=""


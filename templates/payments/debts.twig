{% extends 'layout.twig' %}

{% block title %}Customer Debt Ledger - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">Customer Debt Ledger</h1>
            <p class="text-xs text-slate-500 mt-0.5">Unsettled customer balances for delivered television repairs.</p>
        </div>

        <a href="/repairs" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition">
            &larr; Back to Repairs
        </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden text-xs divide-y divide-slate-100">
        {% for d in debts %}
        <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-bold text-slate-900 text-sm">{{ d.customer_name }}</span>
                    <span class="text-slate-500 font-semibold">{{ d.customer_phone }}</span>
                    {% if d.ticket_number %}
                    <span class="font-mono text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">
                        {{ d.ticket_number }}
                    </span>
                    {% endif %}
                </div>
                <div class="text-slate-500 mt-1">Due Date: {{ d.due_date|default('None') }} · {{ d.notes }}</div>
            </div>

            <div class="flex items-center gap-4 self-end sm:self-auto">
                <div class="text-right">
                    <span class="text-xs text-slate-400 block font-semibold uppercase">Remaining Balance</span>
                    <span class="text-base font-bold text-red-600 tabular-nums">
                        {{ d.currency == 'USD' ? '$' ~ d.remaining_amount : d.remaining_amount|number_format ~ ' IQD' }}
                    </span>
                </div>
            </div>
        </div>
        {% else %}
        <div class="p-8 text-center text-slate-400">No outstanding customer debts found. All repairs settled.</div>
        {% endfor %}
    </div>
</div>
{% endblock %}

<!DOCTYPE html>
<html lang="{{ locale|default('en') }}" dir="{{ is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}{{ trans('app_name') }}{% endblock %}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: {% if is_rtl %}'Vazirmatn', -apple-system, BlinkMacSystemFont, sans-serif{% else %}'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif{% endif %};
            -webkit-tap-highlight-color: transparent;
        }
        .tabular-nums { font-variant-numeric: tabular-nums; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col pb-20 md:pb-6">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <a href="/" class="text-base font-bold text-slate-900 tracking-tight flex items-center gap-2 whitespace-nowrap">
                    <span class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-xs">TV</span>
                    <span>{{ trans('app_name') }}</span>
                </a>
            </div>

            {% if user %}
            <div class="flex items-center gap-2">
                <!-- Language Selector Dropdown Form -->
                <form action="/profile/language" method="POST" class="inline-block">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    <select name="language" onchange="this.form.submit()" class="text-xs bg-slate-50 border border-slate-200 rounded-md py-1 px-2 text-slate-600 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-medium cursor-pointer">
                        <option value="en" {% if locale == 'en' %}selected{% endif %}>EN</option>
                        <option value="ar" {% if locale == 'ar' %}selected{% endif %}>العربية</option>
                        <option value="ckb" {% if locale == 'ckb' %}selected{% endif %}>کوردی</option>
                    </select>
                </form>

                <!-- Profile Link -->
                <a href="/profile" class="px-2.5 py-1 text-xs font-semibold rounded-md bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                    {{ user.name|default(user.email) }}
                </a>

                <!-- Logout -->
                <form action="/logout" method="POST" class="inline-block">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="p-1.5 text-slate-400 hover:text-red-600 transition" title="{{ trans('logout') }}">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    </button>
                </form>
            </div>
            {% endif %}
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-5xl w-full mx-auto p-4">
        {% block content %}{% endblock %}
    </main>

    {% if user %}
    <!-- Mobile Bottom Navigation Bar -->
    <nav class="md:hidden fixed bottom-0 inset-x-0 bg-white border-t border-slate-200 z-40 px-2 py-1 flex items-center justify-around shadow-lg">
        <a href="/" class="flex flex-col items-center py-1 px-3 text-slate-600 hover:text-indigo-600 transition text-center min-w-[56px]">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span class="text-[10px] font-medium leading-none">{{ trans('dashboard') }}</span>
        </a>

        <a href="/repairs" class="flex flex-col items-center py-1 px-3 text-slate-600 hover:text-indigo-600 transition text-center min-w-[56px]">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="text-[10px] font-medium leading-none">{{ trans('repairs') }}</span>
        </a>

        <a href="/inventory" class="flex flex-col items-center py-1 px-3 text-slate-600 hover:text-indigo-600 transition text-center min-w-[56px]">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            <span class="text-[10px] font-medium leading-none">{{ trans('inventory') }}</span>
        </a>

        <a href="/customers" class="flex flex-col items-center py-1 px-3 text-slate-600 hover:text-indigo-600 transition text-center min-w-[56px]">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <span class="text-[10px] font-medium leading-none">{{ trans('customers') }}</span>
        </a>

        {% if user.role == 'OWNER' %}
        <a href="/staff" class="flex flex-col items-center py-1 px-3 text-slate-600 hover:text-indigo-600 transition text-center min-w-[56px]">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span class="text-[10px] font-medium leading-none">{{ trans('staff') }}</span>
        </a>
        {% endif %}
    </nav>
    {% endif %}

    <!-- Full-Screen Blocking Offline Modal -->
    <div id="offline-modal" class="fixed inset-0 bg-slate-900/90 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full text-center shadow-2xl border border-slate-200">
            <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 4.243a9 9 0 01-12.728 0m0 0l2.829-2.829m-2.829 2.829L3 21m2.828-5.464a5 5 0 010-7.072m0 0l2.829 2.829"/></svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-2">{{ trans('offline_title') }}</h2>
            <p class="text-sm text-slate-600 mb-6">{{ trans('offline_message') }}</p>
            <button onclick="checkHeartbeat()" class="w-full py-2.5 px-4 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">
                {{ trans('connecting') }}
            </button>
        </div>
    </div>

    <!-- Active Heartbeat & Offline Detection Script -->
    <script>
        let isOnline = true;
        const offlineModal = document.getElementById('offline-modal');

        function setOfflineState(offline) {
            isOnline = !offline;
            if (offline) {
                offlineModal.classList.remove('hidden');
                // Disable all form submits and inputs while offline
                document.querySelectorAll('button, input, select, textarea').forEach(el => {
                    if (!el.closest('#offline-modal')) {
                        el.setAttribute('data-prev-disabled', el.disabled);
                        el.disabled = true;
                    }
                });
            } else {
                offlineModal.classList.add('hidden');
                // Re-enable form elements
                document.querySelectorAll('button, input, select, textarea').forEach(el => {
                    if (el.hasAttribute('data-prev-disabled')) {
                        el.disabled = (el.getAttribute('data-prev-disabled') === 'true');
                        el.removeAttribute('data-prev-disabled');
                    }
                });
            }
        }

        async function checkHeartbeat() {
            try {
                const response = await fetch('/api/heartbeat', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                });

                if (response.status === 401) {
                    // Session expired! Redirect to login
                    window.location.href = '/login?error=session_expired';
                    return;
                }

                if (response.ok) {
                    if (!isOnline) setOfflineState(false);
                } else {
                    setOfflineState(true);
                }
            } catch (err) {
                setOfflineState(true);
            }
        }

        // Heartbeat interval: every 15 seconds
        setInterval(checkHeartbeat, 15000);

        // Native offline event triggers immediate check
        window.addEventListener('offline', () => setOfflineState(true));
        window.addEventListener('online', () => checkHeartbeat());

        // Global fetch error interceptor
        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
            try {
                const response = await originalFetch(...args);
                if (response.status === 401 && !args[0].toString().includes('/login')) {
                    window.location.href = '/login?error=session_expired';
                }
                return response;
            } catch (error) {
                setOfflineState(true);
                throw error;
            }
        };
    </script>
</body>
</html>

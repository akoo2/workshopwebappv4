<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Intake Ticket - {{ repair.ticket_number }}</title>
    <style>
        @page {
            size: 80mm auto;
            margin: 0;
        }
        body {
            width: 72mm;
            margin: 0 auto;
            padding: 4mm 2mm;
            font-family: 'Courier New', Courier, monospace;
            font-size: 11px;
            line-height: 1.3;
            color: #000;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .bold { font-weight: bold; }
        .divider {
            border-top: 1px dashed #000;
            margin: 6px 0;
        }
        .ticket-no {
            font-size: 16px;
            font-weight: bold;
            margin: 4px 0;
            letter-spacing: 1px;
        }
        .barcode {
            font-family: monospace;
            letter-spacing: 4px;
            font-size: 14px;
            margin: 4px 0;
        }
        @media print {
            .no-print { display: none; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="no-print" style="margin-bottom: 10px; text-align: center;">
        <button onclick="window.print()" style="padding: 6px 12px; font-weight: bold; cursor: pointer;">Print Ticket (80mm)</button>
    </div>

    <div class="text-center">
        <div class="bold" style="font-size: 14px;">TV REPAIR WORKSHOP</div>
        <div>Specialized LED, OLED & Smart TV Service</div>
        <div>Tel: +964 750 000 0000</div>
        <div class="divider"></div>
        <div>INTAKE RECEIPT</div>
        <div class="ticket-no">{{ repair.ticket_number }}</div>
        <div class="barcode">*{{ repair.ticket_number }}*</div>
        <div>{{ repair.created_at }}</div>
    </div>

    <div class="divider"></div>

    <div><span class="bold">Customer:</span> {{ repair.customer_name }}</div>
    <div><span class="bold">Phone:</span> {{ repair.customer_phone }}</div>

    <div class="divider"></div>

    <div><span class="bold">TV Brand:</span> {{ repair.tv_brand }}</div>
    <div><span class="bold">Model:</span> {{ repair.tv_model }}</div>
    {% if repair.tv_serial %}
    <div><span class="bold">Serial:</span> {{ repair.tv_serial }}</div>
    {% endif %}
    <div><span class="bold">Accessories:</span> {{ repair.accessories_received }}</div>

    <div class="divider"></div>

    <div><span class="bold">Reported Fault:</span></div>
    <div>{{ repair.fault_description }}</div>

    <div class="divider"></div>

    <div style="font-size: 9px; line-height: 1.2;">
        <strong>Workshop Terms:</strong><br>
        1. Devices not collected within 30 days of repair completion may incur storage fees.<br>
        2. Please present this original receipt upon device collection.<br>
        3. 30-day warranty applies exclusively to replaced hardware components.
    </div>

    <div class="divider"></div>

    <div style="margin-top: 15px; text-align: center;">
        <div>_________________________</div>
        <div>Customer Signature</div>
    </div>
</body>
</html>

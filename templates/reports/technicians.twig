{% extends 'layout.twig' %}

{% block title %}Technician Productivity - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">Technician Productivity & Turnaround</h1>
            <p class="text-xs text-slate-500 mt-0.5">Tickets completed, bench in-progress count, and labor revenue generated.</p>
        </div>

        <a href="/reports" class="py-2.5 px-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition">
            &larr; Back to P&L Dashboard
        </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden text-xs">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase font-semibold">
                    <tr>
                        <th class="py-3.5 px-4">Technician</th>
                        <th class="py-3.5 px-4">Assigned Tickets</th>
                        <th class="py-3.5 px-4">Completed & Delivered</th>
                        <th class="py-3.5 px-4">On Bench (In Progress)</th>
                        <th class="py-3.5 px-4">Labor Revenue Generated</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-800">
                    {% for t in technicians %}
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-3.5 px-4 font-bold text-slate-900">{{ t.name }}</td>
                        <td class="py-3.5 px-4 tabular-nums">{{ t.total_assigned }}</td>
                        <td class="py-3.5 px-4 font-bold text-emerald-600 tabular-nums">{{ t.completed_count }}</td>
                        <td class="py-3.5 px-4 text-amber-600 tabular-nums">{{ t.in_progress_count }}</td>
                        <td class="py-3.5 px-4 font-bold text-slate-900 tabular-nums">${{ t.total_labor_generated|number_format }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="p-8 text-center text-slate-400">No technicians found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

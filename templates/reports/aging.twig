{% extends 'layout.twig' %}

{% block title %}Aging Unpaid Tickets - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">Aging Unpaid Tickets Analysis</h1>
            <p class="text-xs text-slate-500 mt-0.5">Categorization of open repair tickets and unpaid customer receivables by age.</p>
        </div>

        <a href="/reports" class="py-2.5 px-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition">
            &larr; Back to P&L Dashboard
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
            <span class="font-bold text-slate-700 block">0 - 7 Days (Fresh)</span>
            <div class="text-2xl font-bold text-indigo-600 mt-1">{{ buckets['0_7']|length }} Tickets</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
            <span class="font-bold text-slate-700 block">8 - 30 Days (Active)</span>
            <div class="text-2xl font-bold text-amber-600 mt-1">{{ buckets['8_30']|length }} Tickets</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
            <span class="font-bold text-slate-700 block">31 - 60 Days (Aging)</span>
            <div class="text-2xl font-bold text-orange-600 mt-1">{{ buckets['31_60']|length }} Tickets</div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
            <span class="font-bold text-slate-700 block">&gt; 60 Days (Critical)</span>
            <div class="text-2xl font-bold text-red-600 mt-1">{{ buckets['60_plus']|length }} Tickets</div>
        </div>
    </div>

    <!-- Bucket Listings -->
    <div class="space-y-4 text-xs">
        {% for bucketKey, label in {'60_plus': 'Critical (> 60 Days)', '31_60': 'Overdue Aging (31 - 60 Days)', '8_30': 'Standard Active (8 - 30 Days)', '0_7': 'Fresh Intake (0 - 7 Days)'} %}
        {% if buckets[bucketKey]|length > 0 %}
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
            <h2 class="text-sm font-bold text-slate-900">{{ label }}</h2>
            <div class="divide-y divide-slate-100">
                {% for t in buckets[bucketKey] %}
                <div class="py-2.5 flex items-center justify-between">
                    <div>
                        <a href="/repairs/{{ t.id }}" class="font-bold text-indigo-600 hover:underline">
                            {{ t.ticket_number }} · {{ t.tv_brand }} {{ t.tv_model }}
                        </a>
                        <div class="text-slate-500 mt-0.5">
                            Customer: {{ t.customer_name }} ({{ t.customer_phone }}) · Open for {{ t.days_open|round }} days
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="font-bold text-slate-900 tabular-nums">
                            {{ t.currency == 'USD' ? '$' ~ t.total_charged : t.total_charged|number_format ~ ' IQD' }}
                        </span>
                        <div class="text-[10px] text-slate-400">Status: {{ t.status }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

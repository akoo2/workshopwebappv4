{% extends 'layout.twig' %}

{% block title %}{{ customer.name }} - {{ trans('customers') }}{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <a href="/customers" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition flex items-center gap-1">
            &larr; Back to Customers
        </a>
    </div>

    <!-- Customer Overview Card -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold text-slate-900">{{ customer.name }}</h1>
                <div class="text-xs text-slate-500 mt-1 flex items-center gap-3">
                    <span class="font-bold text-indigo-600">{{ customer.phone }}</span>
                    {% if customer.alt_phone %}<span>· Alt: {{ customer.alt_phone }}</span>{% endif %}
                    {% if customer.address %}<span>· {{ customer.address }}</span>{% endif %}
                </div>
            </div>

            <div class="flex items-center gap-2">
                <a href="/repairs/new?customer_id={{ customer.id }}" class="py-2 px-3.5 bg-indigo-600 text-white rounded-xl text-xs font-semibold hover:bg-indigo-700 transition shadow-xs flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>New Ticket</span>
                </a>
            </div>
        </div>

        <!-- Edit Form -->
        <form action="/customers/{{ customer.id }}" method="POST" class="pt-6 space-y-4 text-xs">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Name</label>
                    <input type="text" name="name" required value="{{ customer.name }}" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
                </div>
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Primary Phone</label>
                    <input type="tel" name="phone" required value="{{ customer.phone }}" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
                </div>
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Alt Phone</label>
                    <input type="tel" name="alt_phone" value="{{ customer.alt_phone|default('') }}" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
                </div>
            </div>

            <div>
                <label class="block font-semibold uppercase text-slate-600 mb-1">Address</label>
                <input type="text" name="address" value="{{ customer.address|default('') }}" class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
            </div>

            <div class="flex justify-end pt-1">
                <button type="submit" class="py-2 px-4 bg-slate-900 text-white rounded-lg font-semibold hover:bg-slate-800 transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>

    <!-- Repair History for this Customer -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <h2 class="text-sm font-bold text-slate-900 mb-4">Repair History ({{ repairs|length }})</h2>

        <div class="divide-y divide-slate-100">
            {% for r in repairs %}
            <div class="py-3 flex items-center justify-between gap-4 text-xs">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-indigo-600">{{ r.ticket_number }}</span>
                        <span class="font-semibold text-slate-800">{{ r.tv_brand }} {{ r.tv_model }}</span>
                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 uppercase">
                            {{ r.status }}
                        </span>
                    </div>
                    <p class="text-slate-500 mt-0.5">{{ r.fault_description|slice(0, 80) }}...</p>
                </div>
                <div class="text-right">
                    <span class="font-bold tabular-nums text-slate-900">
                        {{ r.currency == 'USD' ? '$' ~ r.total_charged : r.total_charged ~ ' IQD' }}
                    </span>
                    <div class="text-[10px] text-slate-400 mt-0.5">{{ r.created_at }}</div>
                </div>
            </div>
            {% else %}
            <div class="text-xs text-slate-400 py-4 text-center">No previous repair tickets for this customer.</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

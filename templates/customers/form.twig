{% extends 'layout.twig' %}

{% block title %}Add Customer - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <a href="/customers" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition flex items-center gap-1">
            &larr; Back to Customers
        </a>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <h1 class="text-xl font-bold text-slate-900 mb-6">New Customer Registry</h1>

        {% if error %}
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs">
            {{ error }}
        </div>
        {% endif %}

        <form action="/customers" method="POST" class="space-y-4 text-xs">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div>
                <label class="block font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    Customer Full Name
                </label>
                <input 
                    type="text" 
                    name="name" 
                    required 
                    value="{{ customer.name|default('') }}"
                    placeholder="e.g. Dana Rashid"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                >
            </div>

            <div>
                <label class="block font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    Primary Phone Number (Used for SMS & Search)
                </label>
                <input 
                    type="tel" 
                    name="phone" 
                    required 
                    value="{{ customer.phone|default('') }}"
                    placeholder="0750XXXXXXX"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                >
            </div>

            <div>
                <label class="block font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    Alternative Phone (Optional)
                </label>
                <input 
                    type="tel" 
                    name="alt_phone" 
                    value="{{ customer.alt_phone|default('') }}"
                    placeholder="0770XXXXXXX"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                >
            </div>

            <div>
                <label class="block font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    Neighborhood / Address (Optional)
                </label>
                <input 
                    type="text" 
                    name="address" 
                    value="{{ customer.address|default('') }}"
                    placeholder="e.g. Ashti Quarter, Street 14"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                >
            </div>

            <div class="pt-4 flex items-center justify-end gap-3">
                <a href="/customers" class="py-2.5 px-4 font-semibold text-slate-600 hover:text-slate-900 transition">
                    {{ trans('cancel') }}
                </a>
                <button type="submit" class="py-2.5 px-5 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 transition shadow-xs">
                    {{ trans('save') }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

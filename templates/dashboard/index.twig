{% extends 'layout.twig' %}

{% block title %}{{ trans('dashboard') }} - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header Welcome Card -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-indigo-600 mb-1">
                {{ trans('app_name') }}
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
                Welcome, {{ user.name }}
            </h1>
            <p class="text-xs text-slate-500 mt-1">
                Signed in as <span class="font-semibold text-slate-700 uppercase">{{ user.role }}</span>
            </p>
        </div>

        <div class="flex items-center gap-2">
            <a href="/repairs/new" class="py-2.5 px-4 bg-indigo-600 text-white rounded-xl text-xs font-semibold hover:bg-indigo-700 transition shadow-xs flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>New Ticket</span>
            </a>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs text-slate-500 font-medium">Open Tickets</div>
            <div class="text-2xl font-bold text-slate-900 mt-1 tabular-nums">0</div>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs text-slate-500 font-medium">On Bench</div>
            <div class="text-2xl font-bold text-indigo-600 mt-1 tabular-nums">0</div>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs text-slate-500 font-medium">Low Stock Items</div>
            <div class="text-2xl font-bold text-amber-600 mt-1 tabular-nums">0</div>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs text-slate-500 font-medium">Staff Accounts</div>
            <div class="text-2xl font-bold text-slate-900 mt-1 tabular-nums">{{ total_staff }}</div>
        </div>
    </div>

    <!-- Quick Actions Card -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <h2 class="text-base font-bold text-slate-900 mb-4">Quick Navigation</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
            <a href="/repairs" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-100 transition flex flex-col items-center">
                <svg class="w-6 h-6 text-indigo-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span class="text-xs font-semibold text-slate-800">{{ trans('repairs') }}</span>
            </a>

            <a href="/inventory" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-100 transition flex flex-col items-center">
                <svg class="w-6 h-6 text-indigo-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                <span class="text-xs font-semibold text-slate-800">{{ trans('inventory') }}</span>
            </a>

            <a href="/customers" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-100 transition flex flex-col items-center">
                <svg class="w-6 h-6 text-indigo-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                <span class="text-xs font-semibold text-slate-800">{{ trans('customers') }}</span>
            </a>

            {% if user.role == 'OWNER' %}
            <a href="/staff" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-100 transition flex flex-col items-center">
                <svg class="w-6 h-6 text-indigo-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                <span class="text-xs font-semibold text-slate-800">{{ trans('staff') }}</span>
            </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

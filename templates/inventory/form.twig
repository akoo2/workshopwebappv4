{% extends 'layout.twig' %}

{% block title %}Add Spare Part - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <a href="/inventory" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition flex items-center gap-1">
            &larr; Back to Inventory
        </a>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <h1 class="text-xl font-bold text-slate-900 mb-6">New Component Registry</h1>

        <form action="/inventory" method="POST" class="space-y-4 text-xs">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Category</label>
                    <select name="category_id" required class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
                        {% for cat in categories %}
                        <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Part / Board Name</label>
                    <input type="text" name="name" required placeholder="e.g. Samsung 55 LED Strip" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
                </div>
            </div>

            <div>
                <label class="block font-semibold uppercase text-slate-600 mb-1">Serial Number / Part Code (Optional)</label>
                <input type="text" name="serial_number" placeholder="e.g. BN44-01053A" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Initial Quantity</label>
                    <input type="number" name="quantity" min="0" value="1" required class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs tabular-nums">
                </div>
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Min Stock Alert Level</label>
                    <input type="number" name="min_stock" min="1" value="2" required class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs tabular-nums">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Cost Price (USD)</label>
                    <input type="number" name="cost_price" placeholder="e.g. 15" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs tabular-nums">
                    <input type="hidden" name="cost_currency" value="USD">
                </div>
                <div>
                    <label class="block font-semibold uppercase text-slate-600 mb-1">Selling Price (USD)</label>
                    <input type="number" name="selling_price" required placeholder="e.g. 30" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white text-xs tabular-nums">
                    <input type="hidden" name="selling_currency" value="USD">
                </div>
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <a href="/inventory" class="py-2.5 px-4 font-semibold text-slate-600 hover:text-slate-900 transition">
                    {{ trans('cancel') }}
                </a>
                <button type="submit" class="py-2.5 px-5 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 transition shadow-xs">
                    {{ trans('save') }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

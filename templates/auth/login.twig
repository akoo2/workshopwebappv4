{% extends 'layout.twig' %}

{% block title %}{{ trans('login') }} - {{ trans('app_name') }}{% endblock %}

{% block content %}
<div class="min-h-[80vh] flex flex-col items-center justify-center py-6 px-4">
    <div class="max-w-md w-full bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <div class="text-center mb-8">
            <div class="w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold text-lg mx-auto mb-3 shadow-sm">
                TV
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{{ trans('login') }}</h1>
            <p class="text-sm text-slate-500 mt-1">{{ trans('tagline') }}</p>
        </div>

        {% if error %}
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-start gap-3">
            <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div>{{ error }}</div>
        </div>
        {% endif %}

        <form action="/login" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    {{ trans('email') }}
                </label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    autocomplete="username"
                    value="{{ email|default('') }}"
                    placeholder="technician@workshop.local"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-base transition"
                >
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    {{ trans('password') }}
                </label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    required 
                    autocomplete="current-password"
                    placeholder="••••••••"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-base transition"
                >
            </div>

            <div class="pt-2">
                <button 
                    type="submit" 
                    class="w-full py-3.5 px-4 bg-indigo-600 text-white rounded-xl font-semibold text-base hover:bg-indigo-700 active:scale-[0.99] transition shadow-xs cursor-pointer"
                >
                    {{ trans('login') }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
